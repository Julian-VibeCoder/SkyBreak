            set_setting(str(k), str(v))
        return jsonify({"updated": True})
    else:
        conn = sqlite3.connect(DB_PATH, timeout=30.0)
        rows = conn.execute("SELECT key, value FROM settings").fetchall()
        conn.close()
        return jsonify({r[0]: r[1] for r in rows})

@app.route("/api/turnarounds", methods=["GET"])
def turnarounds():
    from datetime import datetime, timedelta
    from collections import defaultdict
    import sqlite3
import threading, re
    start_str = request.args.get('start', '')
    end_str = request.args.get('end', '')
    start_days = [int(x) for x in request.args.get('start_days', '').split(',') if x != ''] or [5]
    end_days = [int(x) for x in request.args.get('end_days', '').split(',') if x != ''] or [0]
    max_dep_str = request.args.get('max_dep_dest', '23:59')
    min_ret_str = request.args.get('min_ret_dep', '00:00')
    max_trip_days = int(request.args.get('max_trip_days', '30') or 30)
    start_airport = (request.args.get('start_airport', '') or '').strip().upper() or None
    end_airport = (request.args.get('end_airport', '') or '').strip().upper() or None
    try:
        s = datetime.strptime(start_str, '%Y-%m-%d').date()
        e = datetime.strptime(end_str, '%Y-%m-%d').date()
    except Exception:
        s = datetime.now().date()
        e = s + timedelta(days=14)
    def parse_time(t):
        try: h,m = t.split(':'); return int(h), int(m)
        except: return 23,59
    max_h, max_m = parse_time(max_dep_str)
    min_h, min_m = parse_time(min_ret_str)
    conn = sqlite3.connect(DB_PATH, timeout=10.0)
    rows = conn.execute("SELECT airport_icao, destination_icao, flight_date, flight_number, departure, from_icao, to_icao FROM flights WHERE flight_date >= ? AND flight_date <= ?", (s.strftime('%Y-%m-%d'), e.strftime('%Y-%m-%d'))).fetchall()
    conn.close()
    def fmt_time(t_raw):
        if not t_raw: return None
        s = str(t_raw).strip()
        for z in ['Z','+00:00','+01:00','+02:00','MESZ','CEST','CET','UTC']: s=s.replace(z,'')
        m = re.search(r'(\d{1,2}):(\d{2})', s)
        return f"{int(m.group(1))}:{m.group(2)}" if m else None
    by_date = defaultdict(list)
    for r in rows:
        by_date[r[2]].append({
            'a':(r[0] or '').upper(), 'd':(r[1] or '').upper(),
            'flight': r[3] or '', 'dep_raw': r[4], 'from': (r[5] or '').upper(), 'to': (r[6] or '').upper()
        })
    results = []
    cur = s
    while cur <= e:
        if cur.weekday() in start_days:
            d = cur.strftime('%Y-%m-%d')
            for f in by_date.get(d, []):
                if start_airport and f['a'] != start_airport and f['from'] != start_airport:
                    continue
                dep_time = fmt_time(f['dep_raw'])
                if dep_time:
                    h,m = map(int, dep_time.split(':'))
                    if h > max_h or (h==max_h and m > max_m): continue
                dests = {f['d'], f['to']}; dests.discard('')
                if not dests: dests = {f['d'] or f['a']}
                ret = cur + timedelta(days=1)
                while ret <= e:
                    days = (ret-cur).days
                    if days > max_trip_days: break
                    if ret.weekday() in end_days:
                        rd = ret.strftime('%Y-%m-%d')
                        for rf in by_date.get(rd, []):
                            ret_from = rf['from'] or rf['a']
                            ret_to = rf['to'] or rf['d']
                            if ret_from not in dests and (end_airport is None or ret_from != end_airport):
                                # wildcard if no airport filter; if end_airport set, allow if ret_from==end_airport
                                if end_airport and ret_from != end_airport:
                                    continue
                            ret_time = fmt_time(rf['dep_raw'])
                            if ret_time:
                                h,m = map(int, ret_time.split(':'))
                                if h < min_h or (h==min_h and m < min_m): continue
                            # Build result if airports match (wildcard if none given)
                            if start_airport or end_airport:
                                # Ensure some airport consistency when filters present
                                ok = True
                                if start_airport and (f['a'] != start_airport and f['from'] != start_airport): ok = False
                                if end_airport and ret_to != end_airport and ret_to != (start_airport or ''): ok = False
                                if not ok: continue
                            results.append({
                                'start': d, 'end': rd, 'days': days,
                                'start_airport': f['from'] or f['a'] or start_airport or '',
                                'dest_airport': f['to'] or f['d'] or '',
                                'end_airport': ret_to or end_airport or start_airport or '',
                                'out_flight': f['flight'], 'out_time': dep_time or '-',
                                'ret_flight': rf['flight'], 'ret_time': ret_time or '-'
                            })
                        # One result per pair is enough for test
                        # Break inner loop for speed
                        break
                    ret += timedelta(days=1)
        cur += timedelta(days=1)
    # Deduplicate
    seen = set(); unique = []
    for r in results:
        k = (r['start'], r['end'], r['out_flight'], r['ret_flight'])
        if k not in seen:
            seen.add(k); unique.append(r)
    unique.sort(key=lambda x: (x['start'], x['end']))
    return jsonify({"turnarounds": unique[:50], "count": len(unique)})


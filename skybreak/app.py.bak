@app.route("/api/turnarounds", methods=["GET"])
def turnarounds():
    from datetime import datetime, timedelta
    start_str = request.args.get('start', '')
    end_str = request.args.get('end', '')
    start_days = [int(x) for x in request.args.get('start_days', '').split(',') if x != '']
    end_days = [int(x) for x in request.args.get('end_days', '').split(',') if x != '']
    max_dep_str = request.args.get('max_dep_dest', '23:59')
    min_ret_str = request.args.get('min_ret_dep', '00:00')
    start_airport = request.args.get('start_airport', '').strip().upper() or None
    end_airport = request.args.get('end_airport', '').strip().upper() or None
    max_trip_days_raw = request.args.get('max_trip_days', '30')
    try:
        max_trip_days = int(max_trip_days_raw)
    except Exception:
        max_trip_days = 30
    if not start_days:
        start_days = [5]
    if not end_days:
        end_days = [0]
    try:
        range_start = datetime.strptime(start_str, '%Y-%m-%d').date() if start_str else datetime.now().date()
        range_end = datetime.strptime(end_str, '%Y-%m-%d').date() if end_str else range_start + timedelta(days=30)
    except Exception:
        range_start = datetime.now().date()
        range_end = range_start + timedelta(days=30)
    def parse_time(s):
        try:
            h, m = s.split(':')
            return int(h), int(m)
        except Exception:
            return 23, 59
    max_dep_h, max_dep_m = parse_time(max_dep_str)
    min_ret_h, min_ret_m = parse_time(min_ret_str)
    conn = sqlite3.connect(DB_PATH, timeout=30.0)
    sql = "SELECT airport_icao, destination_icao, flight_date, flight_number, departure, from_icao, to_icao FROM flights WHERE flight_date >= ? AND flight_date <= ?"
    params = [range_start.strftime('%Y-%m-%d'), range_end.strftime('%Y-%m-%d')]
    flights_db = conn.execute(sql, params).fetchall()
    conn.close()
    def fmt_dep(t_raw):
        if not t_raw:
            return None
        s = str(t_raw).strip()
        if ' ' in s and len(s) > 5:
            for p in reversed(s.split(' ')):
                if ':' in p:
                    s = p
                    break
        for z in ['Z', '+00:00', '+01:00', '+02:00', 'MESZ', 'CEST', 'CET', 'UTC']:
            s = s.replace(z, '')
        m = __import__('re').search(r'(\d{1,2}):(\d{2})', s)
        if m:
            return f"{int(m.group(1))}:{m.group(2)}"
        return s if ':' in s else None
    from collections import defaultdict
    flights_by_date = defaultdict(list)
    for r in flights_db:
        airport_icao = (r[0] or '').strip().upper()
        dest_icao = (r[1] or '').strip().upper()
        flight_date = (r[2] or '').strip()
        flight_number = (r[3] or '').strip()
        dep_raw = r[4]
        from_icao = (r[5] or '').strip().upper()
        to_icao = (r[6] or '').strip().upper()
        if flight_date:
            flights_by_date[flight_date].append({
                'airport_icao': airport_icao,
                'destination_icao': dest_icao,
                'flight_number': flight_number,
                'departure_raw': dep_raw,
                'from_icao': from_icao,
                'to_icao': to_icao,
            })
    results = []
    current_start = range_start
    while current_start <= range_end:
        if current_start.weekday() in start_days:
            dt_str = current_start.strftime('%Y-%m-%d')
            out_candidates = flights_by_date.get(dt_str, [])
            out_flights = []
            for f in out_candidates:
                if start_airport and f['airport_icao'] != start_airport and f['from_icao'] != start_airport:
                    continue
                dep_from = f['from_icao'] or f['airport_icao']
                dep_to = f['to_icao'] or f['destination_icao']
                dep_time = fmt_dep(f['departure_raw'])
                if dep_time is not None:
                    try:
                        h_str, m_str = dep_time.split(':')
                        h, m = int(h_str), int(m_str)
                        if h > max_dep_h or (h == max_dep_h and m > max_dep_m):
                            continue
                    except Exception:
                        pass
                out_flights.append({
                    'date': dt_str,
                    'flight_number': f['flight_number'],
                    'from_icao': dep_from,
                    'to_icao': dep_to,
                    'time': dep_time or '-',
                    'airport_icao': f['airport_icao'],
                    'destination_icao': f['destination_icao'],
                })
            for out in out_flights:
                dest_airports = {out['to_icao'], out['destination_icao']}
                dest_airports.discard('')
                if not dest_airports:
                    dest_airports = {out['to_icao'] or out['airport_icao']}
                ret_current = current_start + timedelta(days=1)
                while ret_current <= range_end:
                    trip_days = (ret_current - current_start).days
                    if trip_days > max_trip_days:
                        break
                    if ret_current.weekday() in end_days:
                        ret_dt_str = ret_current.strftime('%Y-%m-%d')
                        ret_candidates = flights_by_date.get(ret_dt_str, [])
                        ret_flights = []
                        for f in ret_candidates:
                            ret_from = f['from_icao'] or f['airport_icao']
                            ret_to = f['to_icao'] or f['destination_icao']
                            target_airport = end_airport or start_airport
                            if ret_from in dest_airports or (end_airport and ret_from == end_airport):
                                ret_time = fmt_dep(f['departure_raw'])
                                if ret_time is not None:
                                    try:
                                        h_str, m_str = ret_time.split(':')
                                        h, m = int(h_str), int(m_str)
                                        if h < min_ret_h or (h == min_ret_h and m < min_ret_m):
                                            continue
                                    except Exception:
                                        pass
                                if target_airport and ret_to != target_airport:
                                    if not (start_airport == end_airport and ret_to == start_airport):
                                        if ret_to != start_airport:
                                            pass
                                ret_flights.append({
                                    'date': ret_dt_str,
                                    'flight_number': f['flight_number'],
                                    'from_icao': ret_from,
                                    'to_icao': ret_to,
                                    'time': ret_time or '-',
                                    'airport_icao': f['airport_icao'],
                                    'destination_icao': f['destination_icao'],
                                })
                        if ret_flights:
                            ret_flights.sort(key=lambda x: x['time'] if x['time'] and x['time'] != '-' else '00:00', reverse=True)
                            best_ret = ret_flights[0]
                            results.append({
                                'start': dt_str,
                                'end': ret_dt_str,
                                'days': trip_days,
                                'start_airport': out['from_icao'] or start_airport or '',
                                'dest_airport': out['to_icao'] or out['destination_icao'] or '',
                                'end_airport': best_ret['to_icao'] or best_ret['destination_icao'] or end_airport or start_airport or '',
                                'out_flight': out['flight_number'],
                                'out_time': out['time'],
                                'ret_flight': best_ret['flight_number'],
                                'ret_time': best_ret['time'],
                            })
                ret_current += timedelta(days=1)
        current_start += timedelta(days=1)
    seen = set()
    unique = []
    for r in results:
        key = (r['start'], r['end'], r.get('out_flight'), r.get('ret_flight'))
        if key not in seen:
            seen.add(key)
            unique.append(r)
    unique.sort(key=lambda x: (x['start'], x['end']))
    return jsonify({"turnarounds": unique, "count": len(unique)})

